rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'studyTrack', 'interests', 'savedArticleIds', 'dislikedArticleIds', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'email', 'studyTrack', 'interests', 'savedArticleIds', 'dislikedArticleIds', 'readingGoalMinutes', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == request.auth.uid && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 3 && data.email.size() <= 150
        && data.studyTrack is string && data.studyTrack.size() <= 100
        && data.interests is list && data.interests.size() <= 50
        && data.savedArticleIds is list && data.savedArticleIds.size() <= 200
        && data.dislikedArticleIds is list && data.dislikedArticleIds.size() <= 200
        && (!('readingGoalMinutes' in data) || (data.readingGoalMinutes is number && data.readingGoalMinutes >= 1 && data.readingGoalMinutes <= 300))
        && data.createdAt is string && data.createdAt.size() <= 50
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
