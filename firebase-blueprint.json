{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student or reader profile storing learning track, topic interests, and cross-device saved library articles.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Firebase Authentication UID of the user."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150,
          "description": "User email address."
        },
        "studyTrack": {
          "type": "string",
          "maxLength": 100,
          "description": "Selected academic major or focus track (e.g. Computer Science & AI)."
        },
        "interests": {
          "type": "array",
          "description": "Array of technology and research interests."
        },
        "savedArticleIds": {
          "type": "array",
          "description": "Array of saved/bookmarked article IDs."
        },
        "dislikedArticleIds": {
          "type": "array",
          "description": "Array of disliked or dismissed article IDs."
        },
        "readingGoalMinutes": {
          "type": "number",
          "description": "Daily reading target in minutes."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "studyTrack",
        "interests",
        "savedArticleIds",
        "dislikedArticleIds",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document indexed by Firebase Auth UID."
    }
  }
}
